# SMTP settings for `python -m aggregator send-approved` (the ONLY command that sends email).
# Sending is OFF by default: it also requires `followups.sending_enabled: true` in config.yaml.
# Copy to .env, fill in, then:  set -a; . ./.env; set +a
# For Gmail use an App Password (Google Account -> Security -> App passwords), not your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_ADDR=you@example.com
