# SMTP settings for `python -m aggregator send-due` / `auto` (the only paths that send email).
# Sending is OFF by default: also requires `followups.sending_enabled: true` (kill switch;
# set it in config.local.yaml). With auto_send: true, due drafts that already have a confirmed
# hiring email go out without a per-message Approve. Copy to .env, fill in, then:
#   set -a; . ./.env; set +a
# For Gmail use an App Password (Google Account -> Security -> App passwords), not your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_ADDR=you@example.com
