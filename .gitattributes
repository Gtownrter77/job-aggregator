# Windows batch files must keep CRLF line endings (stored as-is, never converted)
install/install.bat -text
# installers run by bash must keep LF
*.sh text eol=lf
# Android Gradle wrapper: the shell script must stay LF, the batch file CRLF; the jar is binary
android/gradlew text eol=lf
android/gradlew.bat text eol=crlf
*.jar binary
